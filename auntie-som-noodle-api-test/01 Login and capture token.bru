meta {
  name: Login and capture token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "student",
    "password": "hungry"
  }
}

script:post-response {
  bru.setEnvVar("token", res.getBody().accessToken);
}

tests {
  test("login returns a usable token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string").and.not.empty;
    expect(res.getBody().expiresIn).to.equal(3600);
  });
}
