meta {
  name: Retrieve created order
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
  body: none
  auth: none
}

tests {
  test("retrieved order matches the expected total", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().orderId).to.equal(bru.getVar("orderId"));
    expect(res.getBody().status).to.equal("created");
    expect(res.getBody().totalPrice).to.equal(bru.getVar("expectedTotal"));
  });
}
