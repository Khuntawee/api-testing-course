meta {
  name: Reject invalid login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "student",
    "password": "wrong"
  }
}

tests {
  test("invalid credentials are rejected", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
