meta {
  name: Reject nonexistent item
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "itemId": 9999,
    "quantity": 1
  }
}

tests {
  test("unknown items cannot be ordered", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
