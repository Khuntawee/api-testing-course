meta {
  name: Reject order above available stock
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "itemId": 2,
    "quantity": 2
  }
}

tests {
  test("an order exceeding available stock is rejected", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
