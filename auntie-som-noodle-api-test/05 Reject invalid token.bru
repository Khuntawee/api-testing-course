meta {
  name: Reject invalid token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-token
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

tests {
  test("unknown tokens are rejected", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
