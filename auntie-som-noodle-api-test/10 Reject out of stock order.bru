meta {
  name: Reject out of stock order
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

tests {
  test("an out of stock item cannot be ordered", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
